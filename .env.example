# Copy to .env (never committed) and fill in every empty value.
# The secrets below are generated, never reused across environments:
#   openssl rand -hex 32
#
# Owner of the secrets: the instance operator, sole holder of the server `.env`.
# No value is shipped here: an incomplete `.env` fails `docker compose config` (`${VAR:?}`) or
# the API startup, never a silent start on an example value.
#
# Rotation — to be done on compromise, when a holder leaves, and at least once a year.
# There is no overlap window: every secret is compared against a single value, so rotation is a
# short interruption, to be carried out one secret at a time.
#   BETTER_AUTH_SECRET   restart `api`. Every session is invalidated, each user signs in
#                        again. No other service is affected.
#   MEDIA_TOKEN_SECRET   restart `api`. In-flight media tokens become invalid; a worker that
#                        was downloading gets a 401, its lease expires and the API re-queues
#                        the job. No loss, at worst a replayed job.
#   WORKER_SHARED_TOKEN  restart `api` AND `worker` together — this is the only secret shared
#                        by two services. Between the two restarts the worker loops on 401s
#                        without progressing: do not let the gap settle in.
#   POSTGRES_PASSWORD    `ALTER ROLE` in Postgres first, then the `.env`, then restart `api`
#                        (the `migrate` service reads the same value again on the next up).

# --- API ---
NODE_ENV=development
PORT=3000
# The password is the one from POSTGRES_PASSWORD below: substitute the same value. Under
# compose, the API and the migrator get a URL built from POSTGRES_*, never this one.
DATABASE_URL=postgres://wisper:<POSTGRES_PASSWORD>@localhost:5432/wisper
# Origin of the front end, used for CORS and the session cookies.
WEB_ORIGIN=http://localhost:5173
PUBLIC_API_URL=http://localhost:3000

# Signing secret of the better-auth sessions.
BETTER_AUTH_SECRET=

# --- Google sign-in (optional) ---
# The two values go together: the API refuses to start if only one is set, and Google sign-in
# is offered on screen only when both exist. Without them the platform stays entirely
# self-hosted, with no third-party account.
# To be created in Google Cloud Console > APIs and services > Credentials > OAuth client ID
# (type "Web application"). The authorised redirect URI is exactly:
#   https://YOUR-DOMAIN/api/auth/callback/google
# and, for local development: http://localhost:3000/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# HMAC secret of the media download tokens handed to the workers (short-lived).
MEDIA_TOKEN_SECRET=
# Bearer token presented by a transcription worker to claim a job. Single name for the secret:
# the compose `worker` service receives this very value under the name its code reads
# (`WISPER_WORKER_TOKEN`), so that no rotation can update only one half of it.
WORKER_SHARED_TOKEN=

# Media storage directory (mounted as a volume in production).
MEDIA_STORE_DIR=./media-store
# Maximum size of an accepted media file, in bytes (2 GiB).
MEDIA_MAX_BYTES=2147483648
# Lease duration of a job before it is re-queued, in seconds.
JOB_LEASE_SECONDS=120
# Maximum number of attempts before a transcription fails for good.
JOB_MAX_ATTEMPTS=3

# Port publishing on the host. Accepts an address: behind a reverse proxy (Traefik, nginx), set
# `127.0.0.1:8081` rather than `8080` so that nothing listens on the public IP.
WEB_PORT=8080
API_PORT=3000

# --- Postgres (docker-compose) ---
POSTGRES_USER=wisper
POSTGRES_PASSWORD=
POSTGRES_DB=wisper

# --- Worker ---
# The worker token is NOT declared here: compose derives it from WORKER_SHARED_TOKEN. To run a
# worker outside compose: `WISPER_WORKER_TOKEN="$WORKER_SHARED_TOKEN"`.
WISPER_API_URL=http://localhost:3000
WISPER_WORKER_ID=local-worker
# Transcription binary. `whisper` = openai-whisper installed through pip.
WHISPER_BIN=whisper
WHISPER_MODEL_DIR=
# Models served by this worker, comma-separated. Widen this together with WORKER_MEM_LIMIT,
# never before: `large` asks for roughly 6 GiB.
WISPER_WORKER_MODELS=tiny,base,small,medium
# Bounds of the worker container, to be tuned to the machine hosting it.
WORKER_CPUS=4.0
WORKER_MEM_LIMIT=8g

# Where inference runs. `auto` probes the card at startup and falls back to CPU when it is
# missing; `cpu` and `cuda` force it. The worker announces its decision in its first log line.
WISPER_DEVICE=auto
# CPU inference threads. 0 = infer from the container quota, which is almost always what you
# want: without a bound, torch opens as many threads as the host has cores while the container
# only has two, and inference slows down instead of speeding up.
WISPER_THREADS=0

# --- Diarization (who speaks when) ---
# Both ONNX models live in the worker image: the pass works without setting anything here, and
# it switches itself off, with one log line, if a weight file is missing. It can never make a
# successful transcription fail.
# Threads of the pass. It costs ~0.06x real time on 2 threads, against ~6x for whisper on CPU:
# this is not where you should be looking for time.
WISPER_DIARIZATION_THREADS=2
# Sensitivity of the voice clustering, when the speaker count is not known in advance.
# Higher, two close voices merge into one; lower, a single voice is split into several.
# Measured on a 4-voice reference recording: 0.5 finds 7, 0.8 finds 5, 1.0 finds 3. To be
# calibrated on your own recordings, the value cannot be guessed.
WISPER_DIARIZATION_CLUSTER_THRESHOLD=0.5
# Speaker count, when you know it in advance. -1 = let the clustering decide, which is the
# default; an integer >= 1 pins it and gives far better results when the count really is known.
WISPER_DIARIZATION_MAX_SPEAKERS=-1
# The WAV decoded by the pass lives in the `worker-scratch` volume, next to the downloaded
# media and to whisper's outputs: roughly 115 MiB per hour of audio, for the duration of the
# pass. That volume is shared by every worker on the machine — size it accordingly.

# --- GPU worker (`gpu` profile) ---
# `docker compose --profile gpu up -d` starts a worker that runs on the card, in fp16.
# On a machine that has a card, switch the CPU worker off so they do not fight over RAM:
#   WORKER_CPU_REPLICAS=0
# `large` does not fit in 4 GiB of VRAM; `medium` in fp16 does.
WORKER_CPU_REPLICAS=1
WISPER_GPU_WORKER_ID=gpu-worker
WISPER_GPU_WORKER_MODELS=tiny,base,small,medium
WORKER_GPU_CPUS=2.0
WORKER_GPU_MEM_LIMIT=3g

# Interval between two job requests, in seconds.
POLL_INTERVAL_SECONDS=3
