# Copier en .env (jamais commité) et remplacer chaque valeur.
# Les secrets ci-dessous sont générés, jamais réutilisés entre environnements :
#   openssl rand -hex 32

# --- API ---
NODE_ENV=development
PORT=3000
DATABASE_URL=postgres://wisper:change-me@localhost:5432/wisper
# Origine du front, utilisée pour CORS et les cookies de session.
WEB_ORIGIN=http://localhost:5173
PUBLIC_API_URL=http://localhost:3000

# Secret de signature des sessions better-auth.
BETTER_AUTH_SECRET=
# Secret HMAC des jetons de téléchargement média remis aux workers (courte durée de vie).
MEDIA_TOKEN_SECRET=
# Jeton porteur présenté par un worker de transcription pour réclamer un job.
WORKER_SHARED_TOKEN=

# Répertoire de stockage des médias (monté en volume en production).
MEDIA_STORE_DIR=./media-store
# Taille maximale d'un média accepté, en octets (2 Gio).
MEDIA_MAX_BYTES=2147483648
# Durée du bail d'un job avant remise en file, en secondes.
JOB_LEASE_SECONDS=120
# Nombre maximal de tentatives avant échec définitif d'une transcription.
JOB_MAX_ATTEMPTS=3

# --- Postgres (docker-compose) ---
POSTGRES_USER=wisper
POSTGRES_PASSWORD=change-me
POSTGRES_DB=wisper

# --- Worker ---
WISPER_API_URL=http://localhost:3000
WISPER_WORKER_TOKEN=
WISPER_WORKER_ID=local-worker
# Binaire de transcription. `whisper` = openai-whisper installé via pip.
WHISPER_BIN=whisper
WHISPER_MODEL_DIR=
# Intervalle entre deux demandes de job, en secondes.
POLL_INTERVAL_SECONDS=3
